<?xml version="1.0" encoding="UTF-8"?>
<!--
  一太郎文書 (JTD) のカスタム MIME 登録。
  OpenWebUI 等のヘッダーレス送信環境に対応するため、CFB コンテナ内部の
  一太郎固有ストリームマーカー（SsmgV.01, DocumentText 等）による
  マジックバイト判定（priority 60 > default 40）を定義。
-->
<mime-info>
  <mime-type type="application/vnd.justsystems.ichitaro">
    <_comment>一太郎ドキュメント</_comment>
    <sub-class-of type="application/x-tika-msoffice"/>
    <alias type="application/x-jtd"/>
    <alias type="application/x-ichitaro-jtd"/>
    <alias type="application/jtd"/>
    <glob pattern="*.jtd"/>
    <glob pattern="*.JTD"/>
    <glob pattern="*.jtt"/>
    <glob pattern="*.JTT"/>
    <glob pattern="*.jttc"/>
    <glob pattern="*.JTTC"/>
    <magic priority="60">
      <match value="0xd0cf11e0a1b11ae1" type="string" offset="0:8">
        <match value="SsmgV.01" type="string" offset="512:65536"/>
      </match>
      <match value="0xd0cf11e0a1b11ae1" type="string" offset="0:8">
        <match value="DocumentText" type="unicodeLE" offset="512:65536"/>
      </match>
      <match value="0xd0cf11e0a1b11ae1" type="string" offset="0:8">
        <match value="JSSlip" type="unicodeLE" offset="512:65536"/>
      </match>
      <match value="0xd0cf11e0a1b11ae1" type="string" offset="0:8">
        <match value="JustCompressedDocument" type="string" offset="512:65536"/>
      </match>
      <match value="0xd0cf11e0a1b11ae1" type="string" offset="0:8">
        <match value="JSCompDocument" type="unicodeLE" offset="512:65536"/>
      </match>
      <match value="0xd0cf11e0a1b11ae1" type="string" offset="0:8">
        <match value="-lh5-" type="string" offset="512:65536"/>
      </match>
    </magic>
  </mime-type>
</mime-info>
